FROM rust:1.87.0-bookworm

ARG VERILATOR_VERSION
ARG VERILATOR_SHA256

RUN test -n "$VERILATOR_VERSION" && test -n "$VERILATOR_SHA256" && \
    apt-get update && \
    apt-get install --yes --no-install-recommends \
        autoconf \
        bison \
        ca-certificates \
        flex \
        g++ \
        libfl-dev \
        make \
        perl \
        python3 \
        wget && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

RUN cargo install --locked just --version 1.53.0 && \
    cargo install --locked cargo-nextest --version 0.9.109 && \
    cargo install cargo-llvm-cov && \
    cargo install --locked cargo-mutants --version 26.0.0

RUN wget --output-document verilator.tar.gz \
        "https://github.com/verilator/verilator/archive/refs/tags/v${VERILATOR_VERSION}.tar.gz" && \
    echo "${VERILATOR_SHA256}  verilator.tar.gz" | sha256sum --check && \
    tar --extract --gzip --file verilator.tar.gz && \
    cd "verilator-${VERILATOR_VERSION}" && \
    autoconf && \
    ./configure --prefix=/opt/verilator && \
    make -j"$(nproc)" && \
    make install && \
    test "$(/opt/verilator/bin/verilator --version)" = "Verilator ${VERILATOR_VERSION}"

ENV PATH=/opt/verilator/bin:${PATH}

WORKDIR /workspace
